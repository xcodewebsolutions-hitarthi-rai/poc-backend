# ============================================
# 事件订阅查询技能 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
# 或直接在此文件填入值（不提交到版本库）
# ============================================

# ========== 开放平台鉴权 ==========

# API 基础地址
API_BASE_URL=https://v5devkk1.yonyoucloud.com/

# 应用 Key（从开放平台获取）
API_APP_KEY=your_app_key_here

# 应用密钥（敏感信息，从开放平台获取）
API_APP_SECRET=your_app_secret_here

# ============ 租户配置 ============
# 租户 ID（网关前缀）
YONBIP_TENANT_ID=ozciy868

# 系统标识
YONBIP_SYS_ID=current_yonbip_default_sys

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_FILE=

# ========== 环境配置 ==========
ENV_NAME=production
ENV_DEBUG=false
